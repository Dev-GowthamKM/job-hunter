# Copy this file to .env and fill it in yourself. Never commit .env.
#
# 1. Open Telegram, message @BotFather, send /newbot, follow the prompts.
# 2. Paste the token it gives you below.
TELEGRAM_BOT_TOKEN=

# 3. Start the bridge (npm run bridge), message your own bot once, and it will print your chat id.
#    Paste it here and restart. Without it the bot cannot tell you apart from a client.
TELEGRAM_OWNER_ID=

# Optional. Only needed if you enable the reddit source in config/targets.json.
# Register a free "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
