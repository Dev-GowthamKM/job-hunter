  "autopilot": {
    "_comment": "Full authority mode. When enabled the agents approve and send their own messages, with no tap from Gowtham. Every rule below is a brake that still applies.",
    "enabled": false,
    "channels": [
      "email"
    ],
    "_channels_note": "email only. A Telegram bot cannot message someone who has not messaged it first, and automating a personal WhatsApp number gets it banned.",
    "minScore": 75,
    "requireAngle": true,
    "_requireAngle_note": "never send a lead the researcher did not find a verifiable angle for",
    "holdFirstN": 3,
    "_holdFirstN_note": "the first N messages ever sent still need manual approval, so the quality is seen before anything runs unattended",
    "dailyCap": 10,
    "quietHours": [
      21,
      9
    ],
    "_quietHours_note": "local IST hours when nothing sends. A cold email at 3am reads as a bot.",
    "maxPerCompany": 1
  }
